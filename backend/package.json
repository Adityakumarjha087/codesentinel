{
  "name": "@codesentinel/backend",
  "version": "1.0.0",
  "description": "CodeSentinel API, webhook receiver and review worker",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:prod": "node dist/db/seed.js",
    "webhook:send": "tsx scripts/send-webhook.ts"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@electric-sql/pglite": "^0.4.6",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "bullmq": "^6.7.10",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.64.0",
    "pg": "^8.23.1",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
