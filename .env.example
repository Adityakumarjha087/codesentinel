# ---------------------------------------------------------------------------
# CodeSentinel configuration. Copy to .env (docker compose reads it automatically).
# Defaults run fully offline: mock GitHub, deterministic mock LLM, hashing embeddings.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info                      # fatal|error|warn|info|debug|trace|silent
LOG_PRETTY=false
DATABASE_DRIVER=pg                  # pg | pglite (in-process Postgres, used by tests)
DATABASE_URL=postgres://codesentinel:codesentinel@localhost:20310/codesentinel
AUTO_MIGRATE=true                   # run Drizzle migrations on API start
REDIS_URL=redis://localhost:20311
QUEUE_MODE=inline                   # inline (single process) | bullmq (Redis, separate worker)
RUN_WORKER=true                     # API process also consumes the queue
WORKER_CONCURRENCY=2
STALE_REVIEW_MINUTES=15             # re-enqueue reviews stuck in queued/running (crash recovery)

# --- HTTP / security --------------------------------------------------------
FRONTEND_URL=http://localhost:20300
CORS_ORIGINS=http://localhost:20300 # comma separated allow-list
RATE_LIMIT_MAX=300                  # requests per minute per IP
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false                 # true behind HTTPS
AUTH_DEV_LOGIN=true                 # demo login with role picker; set false in production
ADMIN_GITHUB_LOGINS=                # comma separated GitHub logins that become admins

# --- GitHub App -------------------------------------------------------------
GITHUB_MODE=mock                    # mock (fixture repos, offline) | live (real GitHub App)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=                 # PEM contents; "\n" escapes are supported
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
GITHUB_CLIENT_ID=                   # OAuth app credentials for "Sign in with GitHub"
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:20300/api/auth/github/callback
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# --- LLM --------------------------------------------------------------------
LLM_PROVIDER=mock                   # mock | anthropic | openai | gemini | ollama
LLM_MODEL=                          # default per provider: claude-opus-5-5, gpt-4.1, gemini-2.5-pro, qwen2.5-coder:7b
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_MS=120000
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=medium             # low|medium|high|xhigh|max
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings (repository context index, pgvector 256-d) -------------------
EMBEDDING_PROVIDER=hash             # hash (offline) | openai | ollama
EMBEDDING_MODEL=

# --- Review limits / cost control --------------------------------------------
DEFAULT_MONTHLY_TOKEN_BUDGET=2000000
MAX_FILE_CHANGED_LINES=1500         # skip files with larger diffs
MAX_REVIEW_INPUT_TOKENS=60000       # per LLM call; files are batched under this
MAX_INDEX_FILES=400
